# 로컬 backend 직접 실행 시 localhost, Docker Compose에서는 mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=size_compare
# 로컬 데모 전용 값. 배포 환경에서는 반드시 별도 비밀키 사용
JWT_SECRET_KEY=local-demo-only-change-before-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 사진 업로드를 사용할 때만 AWS S3 설정 필요
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
